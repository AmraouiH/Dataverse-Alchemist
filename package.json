  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "dynamics-365",
    "dataverse",
    "power-platform",
    "model-driven-apps",
    "playwright"
  ],
  "license": "MIT",
  "author": "hamza",
  "repository": "github:AmraouiH/dataverse-alchemist",
  "homepage": "https://github.com/AmraouiH/dataverse-alchemist#readme",
  "type": "module",
  "bin": {
    "dataverse-alchemist": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    ".claude/agents/",
    ".claude/commands/",
    ".claude/skills/",
    ".claude/dataverse-alchemist/",
    "!.claude/dataverse-alchemist/playwright/node_modules/",
